#!/usr/bin/env bash
# Cross-platform-friendly Unix launcher. Windows users should use 开始转换.bat.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
chmod +x "$ROOT/caj-to-pdf" "$ROOT/install-desktop.sh" "$ROOT/开始转换.sh" "$ROOT/安装到桌面.sh" 2>/dev/null || true

if [[ "${1:-}" == "--install" ]]; then
  exec python3 -m app --install
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "还没有安装 Python 3。"
  echo "Debian/Ubuntu：sudo apt install python3 python3-venv python3-pip"
  echo "macOS：请先安装 https://www.python.org/downloads/ 或运行 xcode-select --install"
  exit 1
fi

exec python3 -m app "$@"
